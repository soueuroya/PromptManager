{
  "name": "prompt-manager",
  "displayName": "PromptManager",
  "description": "AI task and prompt orchestration workspace for developers using AI agents",
  "version": "0.0.1",
  "publisher": "daniel-boldrin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USER/prompt-manager.git"
  },
  "homepage": "https://github.com/YOUR_USER/prompt-manager",
  "bugs": {
    "url": "https://github.com/YOUR_USER/prompt-manager/issues"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other",
    "Productivity",
    "AI",
    "Snippets"
  ],
  "keywords": [
    "ai",
    "prompt",
    "workflow",
    "agent",
    "automation",
    "tasks",
    "claude",
    "chatgpt",
    "gemini",
    "windsurf",
    "copilot"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onView:promptManagerView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptManager",
          "title": "PromptManager",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "promptManager": [
        {
          "type": "webview",
          "id": "promptManagerView",
          "name": "PromptManager"
        }
      ]
    },
    "commands": [
      {
        "command": "promptManager.refresh",
        "title": "PromptManager: Refresh"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}